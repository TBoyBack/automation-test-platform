# 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ============ 数据库配置 ============
DATABASE_URL=postgresql://user:password@localhost:5432/test_platform
DATABASE_POOL_SIZE=10

# ============ Redis 配置 ============
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============ Appium 配置 ============
APPIUM_HOST=http://localhost:4723
APPIUM_PORT=4723

# ============ Midscene AI 模型配置 ============
# 使用视觉语言模型（推荐）
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.openai.com/v1
MIDSCENE_MODEL_NAME=gpt-4o

# 或者使用开源模型（如 Qwen-VL）
# MODEL_BASE_URL=http://localhost:8000/v1
# MIDSCENE_MODEL_NAME=Qwen2.5-VL-72B

# ============ 存储配置 ============
# 本地存储
VIDEO_OUTPUT_DIR=./storage/videos
SCREENSHOT_OUTPUT_DIR=./storage/screenshots
REPORT_OUTPUT_DIR=./storage/reports

# 或使用 S3/MinIO
# S3_ENDPOINT=https://your-minio.example.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=test-platform

# ============ 服务配置 ============
PORT=4000
NODE_ENV=development

# JWT 密钥
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 日志级别
LOG_LEVEL=info

# ============ 执行节点配置 ============
EXECUTOR_CONCURRENCY=3
EXECUTOR_TIMEOUT=600

# ============ 设备配置 ============
ANDROID_SDK_PATH=/path/to/android/sdk
ADB_SERVER_HOST=localhost
ADB_SERVER_PORT=5037
