{
  "name": "automation-test-platform",
  "version": "1.0.0",
  "description": "一站式移动端 & Web 自动化测试平台",
  "main": "src/api/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd src/api && npm run dev",
    "dev:web": "cd src/web && npm run dev",
    "build": "npm run build:web && npm run build:server",
    "build:server": "cd src/api && npm run build",
    "build:web": "cd src/web && npm run build",
    "test": "npm run test:api && npm run test:appium && npm run test:midscene",
    "test:api": "node --test src/api/routes/cases.test.js tests/midscene-web-spec.test.js",
    "test:appium": "python -m pytest scripts/appium/ -v",
    "test:midscene": "npx playwright test scripts/midscene/",
    "test:watch": "npx playwright test scripts/midscene/ --ui",
    "lint": "eslint src --ext .ts,.js",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "keywords": [
    "automation",
    "testing",
    "appium",
    "midscene",
    "playwright",
    "ci/cd"
  ],
  "author": "Test Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "ws": "^8.14.2",
    "bull": "^4.11.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "@types/node": "^20.8.10",
    "@types/express": "^4.17.20",
    "@types/cors": "^2.8.15",
    "@types/ws": "^8.5.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
